{
  "name": "chitra-studio",
  "productName": "Chitra Studio",
  "version": "4.2.0",
  "description": "Print-ready design studio for DTF and sublimation",
  "author": "Chitra Studio",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "build": "node prepare.js && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "studio.chitra.desktop",
    "productName": "Chitra Studio",
    "files": [
      "main.js",
      "preload.js",
      "ai/**/*",
      "app/**/*",
      "build/icon.ico",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chitra Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "ai/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "LICENSE-*"
        ]
      }
    ]
  },
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  }
}